// Database schema.
//
// It started as the roster — clients, users and their roles — which is what
// lib/auth/usuarios.ts had been declaring since day one would become a table.
// The device roster came next, and `Measurement` closes it: the readings the
// hardware reports. Two layers, and the seam between them is deliberate. A
// roster row is written by a person and is worth a form; a measurement is
// written by a machine and is worth an index.
//
// What is still absent is any enum of metrics. Which quantities a device
// reports is a row in `Magnitude`, not a column here, and no table below
// decides it.
//
// Models are singular PascalCase because that is how the Prisma client names
// them; tables are plural snake_case, which is how they read in Adminer and in
// a dump. Plural also sidesteps `user`, a reserved word in Postgres that would
// need quoting in every hand-written query.
//
// Note: enum VALUES stay in Spanish. They are domain data, not identifiers —
// they travel inside already-issued JWTs and lib/auth/roles.ts is built on
// them. Renaming those is part of the wider refactor, not of this file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations do not go through the pooler: see .env.example.
  directUrl = env("DIRECT_URL")
}

/// The three hierarchical roles from lib/auth/roles.ts.
///
/// A Postgres enum rather than free text: a mistyped role would be accepted by
/// a text column and sit there, granting nothing, until someone cannot work.
/// Adding a role costs a migration, which is exactly the right amount of
/// ceremony.
enum Role {
  superadmin
  admin
  encargado

  @@map("role")
}

/// A registered company. This is the system's isolation boundary: each client
/// sees only its own, and only the `cliente:cruzar` permission crosses it.
model Client {
  /// A hand-picked slug — "tecvol" — not a generated id: it travels inside
  /// every session token and is read in logs.
  id     String  @id
  label  String
  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  users   User[]
  devices Device[]

  @@map("clients")
}

model User {
  /// Generated, except for seeded users, which keep theirs: the id travels
  /// inside already-issued JWTs and changing it signs everyone out.
  id String @id @default(cuid())

  /// The address they sign in with. There is no separate username: one
  /// identity, which is also the only channel the system could ever use to
  /// reach this person — an alert has to arrive somewhere.
  ///
  /// Always stored normalised — trimmed and lowercased — because the unique
  /// index is case-sensitive and "Ana@x.com" and "ana@x.com" would be two
  /// people. Whoever writes goes through the same normalisation as whoever
  /// looks up; both get it from lib/auth/reglas.ts, which is the one place
  /// that knows what an address is.
  email String @unique
  name  String

  /// scrypt$N$r$p$salt$hash — see lib/auth/contrasena.ts. Never leaves the
  /// server: the types that travel to the client carry no hash.
  hash String

  clientId String @map("client_id")

  /// Credential version. Bumping it invalidates that user's open sessions on
  /// their next refresh, with no revoked-token list to keep. It is bumped when
  /// the password changes or a role is taken away.
  credentialVersion Int @default(1) @map("credential_version")

  /// Soft delete. A user is never removed: records keep naming them.
  active Boolean @default(true)

  /// Whether the password behind `hash` was chosen by whoever created the
  /// account instead of by its owner.
  ///
  /// It records a fact, not a policy: while this is true, somebody else knows
  /// this password. What the product does about it — today a lamp that stays
  /// lit until the owner sets their own — is decided upstairs and can change
  /// without touching this column. It is cleared in the one place where a
  /// person types a password nobody dictated to them.
  provisionalPassword Boolean @default(true) @map("provisional_password")

  /// Who signed for this account. Null for the seeded users, who answer to
  /// nobody; every account created through the application carries its author.
  createdById String? @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  client Client     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  roles  UserRole[]

  /**
   * `Restrict`, like the client relation: an account that gave others cannot
   * be erased out from under them. Nothing hard-deletes a user anyway —
   * `active` is the way out — so this is the database agreeing with that.
   */
  createdBy User?  @relation("Alta", fields: [createdById], references: [id], onDelete: Restrict)
  creados   User[] @relation("Alta")

  /**
   * Devices this person signed for. Same `Restrict` reasoning as above.
   */
  devices Device[] @relation("AltaDispositivo")

  @@index([clientId])
  @@map("users")
}

/// A user's roles, one per row.
///
/// A table and not a column, because a user really can hold several: the
/// product shows an administrator who may or may not also be an encargado, and
/// a single column cannot express that.
model UserRole {
  userId    String   @map("user_id")
  role      Role
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

/// A microcontroller installed on a piece of equipment so that it reports.
///
/// This table is the roster, not the time series. A row here says a device
/// exists, belongs to one company and reports certain magnitudes; what it has
/// actually measured is another table, on another layer, and that layer does
/// not exist yet.
///
/// Thresholds are deliberately NOT here. One microcontroller reports several
/// magnitudes — bus voltage, current, winding temperature, power factor — and
/// each has its own minimum and maximum. A `min`/`max` pair on this row would
/// have to be torn out the day a device reports two things, which is the
/// normal case and not the exception. See `Magnitude`.
model Device {
  id String @id @default(cuid())

  /// The hardware identity the device reports as its own.
  ///
  /// Unique across the whole system, and this is the column that will let an
  /// incoming message be attributed to a row: the transport is not built yet,
  /// but whatever it turns out to be, it arrives carrying this and nothing
  /// else that the application chose. Generated ids cannot do that job — the
  /// microcontroller does not know its own cuid.
  ///
  /// It is also what a broker topic gets derived from, rather than a topic
  /// being stored alongside it: two columns that have to agree are two columns
  /// that will eventually disagree.
  serial String @unique

  /// What it is called on screen — "Tablero principal", "Grupo 1".
  label String

  /// Where it is installed, in the trade's own words: a hull, an engine room,
  /// a berth. Free text and optional, because the roster does not know what
  /// the next installation will be mounted on.
  location String?

  clientId String @map("client_id")

  /// Soft delete, like a user. A device is decommissioned, never erased: its
  /// readings will name it, and its thresholds are worth keeping for the day
  /// the same hardware goes back into service.
  active Boolean @default(true)

  /// Who signed for this device. Null is possible for rows that predate the
  /// author column or come from a script.
  createdById String? @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  client     Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdBy  User?       @relation("AltaDispositivo", fields: [createdById], references: [id], onDelete: Restrict)
  magnitudes Magnitude[]

  @@index([clientId])
  @@map("devices")
}

/// One quantity a device reports, with the thresholds that raise its alarm.
///
/// A table and not a set of columns because PRODUCT.md is explicit that which
/// metrics get reported is undecided. An enum or a fixed column per metric
/// would be this project deciding it by accident, and every new magnitude
/// would cost a migration. Here a magnitude is data: someone enters it.
model Magnitude {
  id String @id @default(cuid())

  deviceId String @map("device_id")

  /// The key the device reports this magnitude under, inside its message.
  ///
  /// Derived from the label the same way a client id is derived from a company
  /// name (lib/identificador.ts) — never typed by hand — so it is stable,
  /// URL-safe and readable in a log. Unique per device: one device does not
  /// report the same quantity twice.
  key String

  /// "Tensión de barra". The label is what a person reads; `key` is what the
  /// hardware says.
  label String

  /// "V", "A", "°C". Optional, because a power factor has no unit and a blank
  /// unit column would have to be faked as one.
  unit String?

  /// The thresholds that raise the alarm. Nullable, and that is the point: a
  /// winding temperature has a maximum and no meaningful minimum, and a null
  /// says "no threshold on that side" where a zero would say "alarm below
  /// zero" — two different instructions to whatever ends up watching them.
  ///
  /// Double precision and not `Decimal`: these are instrument readings, not
  /// money, and a Prisma `Decimal` does not cross the server→client boundary
  /// without a translation on every screen that shows one.
  min Float?
  max Float?

  /// The floor and ceiling of the dial this magnitude is drawn on.
  ///
  /// **Not the same numbers as `min`/`max`, and this is the distinction the
  /// whole panel rests on.** Those two are the thresholds that raise an alarm;
  /// these two are the extent of the instrument. A winding temperature alarms
  /// above 75 °C and has no meaningful minimum, but its dial still has to start
  /// somewhere — and a bus voltage watched between 385 V and 420 V still has to
  /// show a reading of 380 V rather than pushing the needle off the face.
  ///
  /// Nullable, and a magnitude without them is not a broken magnitude: it is
  /// one the screen draws as a digital readout instead of a dial. A needle
  /// needs a declared scale, and inventing one from the data would move the
  /// face under the needle every time a new extreme arrived.
  ///
  /// Both or neither, and floor strictly below ceiling. That is a CHECK
  /// constraint in the migration rather than a comment here, because half a
  /// scale is not a state this system should be able to hold: it would reach
  /// the gauge as a division by zero or as an arc with no length.
  scaleMin Float? @map("scale_min")
  scaleMax Float? @map("scale_max")

  /// Soft delete, like its device. A magnitude that has been measured cannot
  /// be erased without erasing the history that names it.
  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /**
   * Cascade, unlike everything else in this schema: a magnitude has no life
   * of its own away from its device. Nothing hard-deletes a device anyway.
   */
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  /**
   * Cascade too, and for the same reason: a reading has no life away from the
   * magnitude that produced it. Nothing hard-deletes a magnitude anyway —
   * `active` is the way out — so this is the database agreeing with that.
   */
  measurements Measurement[]

  @@unique([deviceId, key])
  @@map("magnitudes")
}

/// One reading of one magnitude, at one instant.
///
/// This is the time series, and it is the table that will grow without bound
/// while every other one in this schema stays the size of a roster. Everything
/// below is decided by that.
///
/// **Two timestamps, not one.** `measuredAt` is what the device says;
/// `receivedAt` is what the server saw. Keeping both is the only thing that
/// lets the product say honestly how old a reading is — ships sail, lose
/// signal, and dump a fortnight of samples the moment they are back in range.
/// With a single timestamp that batch either looks like it was all measured on
/// arrival or like it arrived when it was measured, and both are lies.
///
/// **It hangs off the magnitude, not off the device.** The magnitude is what
/// carries the unit and the thresholds, so it is what a number means something
/// against. A `deviceId` here would be a second path to the same fact, and two
/// columns that have to agree eventually disagree.
///
/// **No surrogate id, and the primary key is the query.** Nothing references a
/// measurement, so an `id` column would be an extra 25 bytes and an extra
/// index on the biggest table in the system, bought for nothing. The composite
/// key `(magnitudeId, measuredAt)` is the index this table gets read by —
/// one magnitude over a range of time, or its latest sample by scanning that
/// same btree backwards — and it does a second job for free: it makes ingest
/// idempotent. MQTT delivers at least once and a bridge that times out will
/// re-POST, so without this key every retry silently doubles a reading and
/// every later average is wrong. With it, a retry is free.
///
/// The cost of that key is real and worth naming: a device that genuinely
/// measures the same magnitude twice inside the same millisecond loses the
/// second sample. That is not a cadence this product has, and if it ever
/// arrives the fix is a finer timestamp — not a second row claiming the same
/// instant, which no later query could tell apart anyway.
model Measurement {
  magnitudeId String @map("magnitude_id")

  /// When the device says it measured. It comes from outside and it is
  /// believed, within reason: the ingest endpoint refuses a timestamp from the
  /// future, and accepts any past.
  measuredAt DateTime @map("measured_at") @db.Timestamptz(3)

  /// When this server took it. Written here and never by the caller.
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  /// Double precision, like the thresholds it will be compared against. Same
  /// reasoning: an instrument reading is not money.
  value Float

  magnitude Magnitude @relation(fields: [magnitudeId], references: [id], onDelete: Cascade)

  @@id([magnitudeId, measuredAt])
  @@map("measurements")
}
